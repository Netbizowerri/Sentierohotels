# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Optional Google Maps API key for interactive map and directions
VITE_GOOGLE_MAPS_API_KEY=""

# Guest bookings and inquiries are emailed to the admin inbox via Formspree
# (https://formspree.io/f/xnpnnadb) directly from the client — no server env vars needed.